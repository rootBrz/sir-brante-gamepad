<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-time stand-in for the game's TextMeshPro assembly: only the members this plugin calls. -->
  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>Unity.TextMeshPro</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2018.3.0" PrivateAssets="all" />
    <PackageDownload Include="Unity3D.UnityEngine.UI" Version="[2018.3.5.1]" />
    <Reference Include="UnityEngine.UI">
      <HintPath>$(NuGetPackageRoot)unity3d.unityengine.ui/2018.3.5.1/lib/UnityEngine.UI.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
